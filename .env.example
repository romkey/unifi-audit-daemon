# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- UniFi Protect -----------------------------------------------------------

# The UniFi OS console running Protect: an address or host name.
UNIFI_HOST=192.168.1.1

# HTTPS port on the console.
# UNIFI_PORT=443

# A local UniFi OS account (not a UI.com cloud account) that can view
# Protect. The private API signs in as this user.
UNIFI_USERNAME=audit-daemon
UNIFI_PASSWORD=REPLACE_ME

# Consoles ship with a self-signed certificate; set false to accept it.
# UNIFI_VERIFY_SSL=true

# --- Audit log ---------------------------------------------------------------

# Where the audit log and sync state are kept: private, never serve it.
# The image sets /data.
# DATA_DIR=data

# Seconds between syncs with Protect.
# SYNC_INTERVAL=60

# Seconds each sync re-reads before where the last one stopped, for events
# Protect files late. Duplicates are dropped.
# SYNC_OVERLAP=600

# Days of history to fetch on the very first sync.
# BACKFILL_DAYS=7

# Only record these event types (comma-separated); empty records all.
# EVENT_TYPES=access,videoExported,videoDeleted,nvrSettingsChanged,deviceAdopted,deviceUnadopted

# --- Contact sheet -----------------------------------------------------------

# Where the contact sheets are kept, apart from the audit log, so this
# directory alone can be served. Must not contain DATA_DIR. The image sets
# /contact-sheets.
# CONTACT_SHEET_DIR=contact-sheets

# Optional second token that can only read the contact sheets (list and
# images), to share with whoever views them. At least 16 characters, and
# different from API_TOKEN.
# CONTACT_SHEET_TOKEN=REPLACE_ME_WITH_ANOTHER_LONG_RANDOM_TOKEN

# Local time to take the nightly contact sheet, HH:MM.
# CONTACT_SHEET_TIME=03:00

# Time zone for CONTACT_SHEET_TIME and the sheet's date. Without it a
# container runs on UTC.
TZ=America/Los_Angeles

# Days of contact sheets to keep; 0 keeps them all.
# CONTACT_SHEET_RETENTION_DAYS=30

# Width in pixels of each camera's picture on the sheet.
# CONTACT_SHEET_TILE_WIDTH=640

# Cameras per row; 0 picks a near-square grid.
# CONTACT_SHEET_COLUMNS=0

# --- HTTP API ----------------------------------------------------------------

# Bearer token clients (Member Zone) must send. At least 16 characters;
# generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_TOKEN

# Address to listen on. The Docker image sets 0.0.0.0; natively the
# default, 127.0.0.1, keeps the app private to this machine.
# HOST=127.0.0.1

# Port to listen on.
PORT=8000

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
